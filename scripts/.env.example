# Meshy API key — get one at https://meshy.ai  (sign in -> API keys)
# format: msy-xxxxxxxx
MESHY_API_KEY=msy-PUT-YOUR-KEY-HERE

# Publicly accessible URL of your selfie (Meshy downloads it from the cloud).
# Upload to imgur / sm.ms / GitHub raw, then paste the DIRECT image URL here.
IMAGE_URL=https://i.imgur.com/your-selfie.jpg
